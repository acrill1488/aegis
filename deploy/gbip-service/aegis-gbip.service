[Unit]
Description=AEGIS GBIP observation service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aegis
Group=aegis
WorkingDirectory=/opt/AEGIS
EnvironmentFile=/etc/aegis/gbip.env
ExecStart=/opt/AEGIS/.venv/bin/python -m aegis.cli.main greenboost serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
